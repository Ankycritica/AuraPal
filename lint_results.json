xt-slate-100\">\r\n            Stranger\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Controls */}\r\n      <div className=\"flex flex-wrap items-center justify-center gap-3 mt-2\">\r\n        <Button\r\n          type=\"button\"\r\n          variant=\"outline\"\r\n          className=\"bg-slate-900/80 border-slate-700 text-slate-100 hover:bg-slate-800\"\r\n        >\r\n          Mute\r\n        </Button>\r\n\r\n        <Button\r\n          type=\"button\"\r\n          variant=\"outline\"\r\n          className=\"bg-slate-900/80 border-slate-700 text-slate-100 hover:bg-slate-800\"\r\n        >\r\n          Turn Camera Off\r\n        </Button>\r\n      </div>\r\n    </div>\r\n  )\r\n}","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\donga\\Documents\\AuraPal\\AuraPal\\src\\lib\\utils.js","messages":[{"ruleId":"no-useless-escape","severity":2,"message":"Unnecessary escape character: \\-.","line":30,"column":19,"nodeType":"Literal","messageId":"unnecessaryEscape","endLine":30,"endColumn":20,"suggestions":[{"messageId":"removeEscape","fix":{"range":[840,841],"text":""},"desc":"Remove the `\\`. This maintains the current functionality."},{"messageId":"escapeBackslash","fix":{"range":[840,840],"text":"\\"},"desc":"Replace the `\\` with `\\\\` to include the actual backslash character."}]},{"ruleId":"no-useless-escape","severity":2,"message":"Unnecessary escape character: \\-.","line":31,"column":15,"nodeType":"Literal","messageId":"unnecessaryEscape","endLine":31,"endColumn":16,"suggestions":[{"messageId":"removeEscape","fix":{"range":[867,868],"text":""},"desc":"Remove the `\\`. This maintains the current functionality."},{"messageId":"escapeBackslash","fix":{"range":[867,867],"text":"\\"},"desc":"Replace the `\\` with `\\\\` to include the actual backslash character."}]},{"ruleId":"no-useless-escape","severity":2,"message":"Unnecessary escape character: \\-.","line":31,"column":17,"nodeType":"Literal","messageId":"unnecessaryEscape","endLine":