/>\n\n      {/* ΓöÇΓöÇ Main content ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ */}\n      <main className=\"flex-1 flex flex-col min-h-screen overflow-hidden\">\n\n        {/* ΓöÇΓöÇ Top bar (only while chatting) ΓöÇΓöÇ */}\n        <AnimatePresence>\n          {chatMode && (\n            <motion.div\n              initial={{ opacity: 0, y: -20 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -20 }}\n              transition={{ duration: 0.25 }}\n              className=\"flex items-center justify-between px-6 py-3 border-b border-white/5 bg-zinc-950/80 backdrop-blur-sm z-10\"\n            >\n              <div className=\"flex items-center gap-3\">\n                <div className={`w-2 h-2 rounded-full ${chatMode === 'text' ? 'bg-emerald-400' : 'bg-amber-400'} shadow-lg`} />\n                <span className=\"text-sm font-semibold text-white\">\n                  {chatMode === 'text' ? '≡ƒÆ¼ Text Chat' : '≡ƒÄÑ Video Chat'}\n                </span>\n                {matchConfig?.isPremium && (\n                  <span className=\"text-[10px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 rounded-full px-2 py-0.5\">\n                    Γ¡É PREMIUM\n                  </span>\n                )}\n              </div>\n\n              <div className=\"flex items-center gap-3\">\n                {/* Mode switcher */}\n                <div className=\"flex bg-zinc-800 border border-zinc-700 rounded-lg p-0.5 gap-0.5\">\n                  <button\n                    onClick={() => {\n                      setChatMode(null)\n                      setTimeout(() => {\n                        setChatMode('text')\n                      }, 100)\n                    }}\n                    className={`px-3 py-1 rounded-md text-xs font-medium transition-all ${chatMode === 'text'\n                      ? 'bg-zinc-600 text-white shadow'\n                      : 'text-zinc-400 hover:text-white'\n                      }`}\n                  >\n                    ≡ƒÆ¼ Text\n                  </button>\n                  <button\n                    onClick={() => {\n                      setChatMode(null)\n                      setTimeout(() => {\n                        setChatMode('video')\n                      }, 100)\n                    }}\n                    className={`px-3 py-1 rounded-md text-xs font-medium transition-all ${chatMode === 'video'\n                      ? 'bg-zinc-600 text-white shadow'\n                      : 'text-zinc-400 hover:text-white'\n                      }`}\n                  >\n                    ≡ƒÄÑ Video\n                  </button>\n                </div>\n\n                <button\n                  onClick={handleEndChat}\n                  className=\"px-3 py-1.5 rounded-lg text-xs font-medium text-zinc-400 hover:text-white hover:bg-zinc-800 border border-zinc-700 transition-all\"\n                >\n                  ΓåÉ Back\n                </button>\n              </div>\n            </motion.div>\n          )}\n        </AnimatePresence>\n\n        {/* ΓöÇΓöÇ Chat content ΓöÇΓöÇ */}\n        <div className=\"flex-1 flex items-center justify-center p-4 sm:p-6 overflow-hidden\">\n          <AnimatePresence mode=\"wait\">\n            {/* ΓöÇ Start screen ΓöÇ */}\n            {!chatMode && (\n              <motion.div\n                key=\"start\"\n                initial={{ opacity: 0, scale: 0.97, y: 12 }}\n                animate={{ opacity: 1, scale: 1, y: 0 }}\n                exit={{ opacity: 0, scale: 0.97, y: -8 }}\n                transition={{ duration: 0.3 }}\n                className=\"w-full flex justify-center\"\n              >\n                <StartChat onStartChat={handleStartChat} />\n              </motion.div>\n            )}\n\n            {/* ΓöÇ Text chat ΓöÇ */}\n            {chatMode === 'text' && (\n              <motion.div\n                key=\"text\"\n                initial={{ opacity: 0, x: 20 }}\n                animate={{ opacity: 1, x: 0 }}\n                exit={{ opacity: 0, x: -20 }}\n                transition={{ duration: 0.3 }}\n                className=\"w-full h-full flex\"\n                style={{ maxWidth: '780px', height: 'calc(100vh - 140px)', minHeight: '520px' }}\n              >\n                <TextChat config={matchConfig} onEnd={handleEndChat} />\n              </motion.div>\n            )}\n\n            {/* ΓöÇ Video chat ΓöÇ */}\n            {chatMode === 'video' && (\n              <motion.div\n                key=\"video\"\n                initial={{ opacity: 0, x: 20 }}\n                animate={{ opacity: 1, x: 0 }}\n                exit={{ opacity: 0, x: -20 }}\n                transition={{ duration: 0.3 }}\n                className=\"w-full\"\n              >\n                <VideoChat config={matchConfig} onEnd={handleEndChat} />\n              </motion.div>\n            )}\n          </AnimatePresence>\n        </div>\n      </main>\n    </div>\n  )\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\donga\\Documents\\AuraPal\\AuraPal\\src\\pages\\ChatTest.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\donga\\Documents\\AuraPal\\AuraPal\\src\\pages\\Dashboard.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\donga\\Documents\\AuraPal\\AuraPal\\src\\pages\\Features.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\donga\\Documents\\AuraPal\\AuraPal\\src\\pages\\Home.jsx","messages":[{"ruleId":"no-unused-vars","severity":2,"message":"