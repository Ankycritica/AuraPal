lStorage.setItem(KEY, JSON.stringify(data))\r\n    setGuest(data)\r\n  }, [])\r\n\r\n  // Called by chat with identity data\r\n  const startAsGuest = useCallback((data) => {\r\n    saveGuest(data)\r\n    localStorage.setItem(ONBOARDED_KEY, 'true')\r\n    setIsOnboarded(true)\r\n  }, [saveGuest])\r\n\r\n  return {\r\n    guest,\r\n    saveGuest,\r\n    startAsGuest,\r\n    isOnboarded,\r\n    setOnboarded: (v) => {\r\n      localStorage.setItem(ONBOARDED_KEY, v ? 'true' : 'false')\r\n      setIsOnboarded(v)\r\n    }\r\n  }\r\n}\r\n\r\nexport default useGuest\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\donga\\Documents\\AuraPal\\AuraPal\\src\\lib\\analytics.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\donga\\Documents\\AuraPal\\AuraPal\\src\\lib\\guest.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\donga\\Documents\\AuraPal\\AuraPal\\src\\lib\\mockData.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\donga\\Documents\\AuraPal\\AuraPal\\src\\lib\\socketVideo.js","messages":[{"ruleId":"no-unused-vars","severity":2,"message":"'config' is defined but never used.","line":5,"column":37,"nodeType":"Identifier","messageId":"unusedVar","endLine":5,"endColumn":43,"suggestions":[{"messageId":"removeVar","data":{"varName":"config"},"fix":{"range":[148,155],"text":""},"desc":"Remove unused variable 'config'."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// src/components/VideoChat.jsx\r\nimport React, { useRef } from 'react'\r\nimport { Button } from './ui/but